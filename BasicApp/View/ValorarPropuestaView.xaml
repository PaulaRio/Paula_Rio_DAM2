<UserControl x:Class="BasicApp.View.ValorarPropuestaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BasicApp.View"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Wheat">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.ColumnSpan="2"  Content="{Binding Titulo}" Foreground="Black" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="30"/>
            
        
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
        <Label  Content="Título" Foreground="Black" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="24"/>
        <ui:TextBlock Text="{Binding NomAlumno}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
        <Label  Content="Tipo" Foreground="Black" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="24"/>
        <ui:TextBlock  Text="{Binding Tipo}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
        <Label  Content="Descripcion" Foreground="Black" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="24"/>
        <ui:TextBlock Text="{Binding Descripcion}"/>
        </StackPanel>
        <ui:Button Grid.Row="4" Grid.Column="0" Content="Aprobar" Foreground="Black" FontWeight="Bold" Background="Peru" HorizontalAlignment="Center" Command="{Binding AprobarCommand}"/>
        <ui:Button Grid.Row="4" Grid.Column="1" Content="Rechazar" Foreground="Black" FontWeight="Bold" Background="Peru" HorizontalAlignment="Center" Command="{Binding RechazarCommand}"/>



    </Grid>
</UserControl>
