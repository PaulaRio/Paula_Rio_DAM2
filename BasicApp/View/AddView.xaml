<Window x:Class="BasicApp.View.AddView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BasicApp.View"
      xmlns:viewModel="clr-namespace:BasicApp.ViewModel" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance Type=viewModel:AddViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="450"
      Title="AddView">

    <Grid>
        <Border CornerRadius="10" Background="#8E44AD" Width="300" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <StackPanel>

               
                <Label Content="Login" FontWeight="Bold" FontSize="24" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center" Height="35" Width="90" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>


                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10" >
                    <ui:TextBox PlaceholderText="Enter the Title" Height="40" Margin="0,0,0,10"  />
                </Border>

                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10">
                    <DatePicker/>
                </Border>
               
                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10">
                    <ui:TextBox PlaceholderText="Enter the Lifetime Gross" Height="40" Margin="0,0,0,10" />
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Back" Foreground="#4263EB" Background="White" BorderThickness="0" Cursor="Hand"  Command="{Binding Back_ClickCommand}" Grid.Column="0" Margin="10,0,0,0"/>
                    <Button Content="Save" Foreground="#4263EB" Background="White" BorderThickness="0" Cursor="Hand"  Command="{Binding Save_ClickCommand}" Margin="199,0,0,0"/>
                </Grid>

 
            </StackPanel>
        </Border>
    </Grid>
</Window>
