<UserControl x:Class="BasicApp.View.DataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BasicApp.View"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#6A0DAD">
            <StackPanel>
                <!-- Logo -->
                <Border Background="#8E44AD" Padding="10">
                    <TextBlock Text="Gestor Archivos" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Opciones del menú -->
                <ui:Button Command="{Binding SelectViewModelCommand}" 
                        CommandParameter="{Binding LoginViewModel}" 
                        Background="Transparent" Foreground="White" 
                        BorderBrush="Transparent" 
                        Margin="10" Padding="10" 
                        HorizontalAlignment="Left"
                        Content="Login!"
                        Icon="{ui:SymbolIcon Fluent24}"/>

                <Button Command="{Binding SelectViewModelCommand}" 
                        CommandParameter="{Binding RegisterViewModel}" 
                        Background="Transparent" Foreground="White" 
                        BorderBrush="Transparent" 
                        Margin="10" Padding="10" 
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="Abrir Archivo" FontSize="16"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding SelectViewModelCommand}" 
                        CommandParameter="{Binding PrincipalViewModel}" 
                        Background="Transparent" Foreground="White" 
                        BorderBrush="Transparent" 
                        Margin="10" Padding="10" 
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="Principal" FontSize="16"/>
                    </StackPanel>
                </Button>


                <StackPanel VerticalAlignment="Bottom" Margin="10">
                    <Button Background="Transparent" 
                            Foreground="White" 
                            BorderBrush="Transparent" 
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="18" Margin="0,0,10,0" />
                            <TextBlock Text="Logout" FontSize="16"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1">
            <StackPanel >
                <ItemsControl ItemsSource="{Binding Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5">
                                <StackPanel>
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform" Height="100"/>
                                    <TextBlock Text="{Binding PokemonName}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
