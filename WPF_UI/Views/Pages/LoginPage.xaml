<Page
    x:Class="Wpf.Ui.Demo.Mvvm.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Demo.Mvvm.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LoginPage"
    Background="#3b82f6"
    
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" Height="298">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <TextBlock 
            Grid.Row="0" 
            Text="Login" 
            FontSize="24" 
            FontWeight="Bold" 
            HorizontalAlignment="Center" 
            Margin="0,0,0,20" />


        <Grid Grid.Row="1" Width="300" Height="40" Margin="0,5" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBox Name="EmailTextBox" VerticalAlignment="Center" Padding="5" Text="Enter your email" 
            IsHitTestVisible="False" 
            Foreground="Gray" 
            Margin="5,0,0,0" 
              />
            <!--Visibility="{Binding Text, ElementName=EmailTextBox, Converter={StaticResource TextToVisibilityConverter}}"-->

        </Grid>


        <Grid Grid.Row="2" Width="300" Height="40" Margin="0,5" VerticalAlignment="Center" HorizontalAlignment="Center">
            <PasswordBox Name="PasswordBox" VerticalAlignment="Center" Padding="5" />
            <TextBlock Text="Enter your password" 
                       IsHitTestVisible="False" 
                       Foreground="Gray" 
                       Margin="5,0,0,0" 
                       VerticalAlignment="Center" 
                        />
            <!--Visibility="{Binding Password, ElementName=PasswordBox, Converter={StaticResource TextToVisibilityConverter}}"-->
        </Grid>

        <StackPanel Grid.Row="3">
            <Grid>
                <CheckBox 
            Content="Remember me" 
            VerticalAlignment="Top" 
            Margin="10,17,0,0" />
                <TextBlock Text="Forgot password" Foreground="#3b82f6" Height="22" HorizontalAlignment="Right" Margin="0,19,10,8" />
            </Grid>
        </StackPanel>


        <Button 
            Grid.Row="4" 
            Content="Login Now" 
            Width="300" 
            Height="40" 
            Background="#3b82f6" 
            Foreground="White" 
            FontWeight="Bold" 
            VerticalAlignment="Top" 
            Margin="0,10,0,0" />


        <StackPanel 
            Grid.Row="4" 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            Margin="0,45,0,-35">

            <TextBlock Text="Don't have an account?" Height="21" />

            <TextBlock Text="Sign up now" Foreground="#3b82f6" Height="22" />

        </StackPanel>
    </Grid>
</Page>
