<Window x:Class="Examen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Examen"
        xmlns:view="clr-namespace:Examen.View"
        xmlns:viewModel="clr-namespace:Examen.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewModel:MainViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModel:PrincipalViewModel}">
            <view:PrincipalView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:Ventana2ViewModel}">
            <view:Ventana2View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ImportViewModel}">
            <view:ImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ExportViewModel}">
            <view:ExportView/>
        </DataTemplate>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Menu FontSize="15" Grid.Row="0" HorizontalAlignment="Center"  Height="30"  >
            
            <MenuItem  Header="Galaxy Overview"  BorderBrush="Gray" Background="AliceBlue" Command="{Binding SelectViewModelCommand}"
          CommandParameter="{Binding PrincipalViewModel}" Height="29"/>
            <MenuItem Header="Ventana" Width="100"  BorderBrush="Gray" Background="AliceBlue" Command="{Binding SelectViewModelCommand}"
          CommandParameter="{Binding Ventana2ViewModel}" RenderTransformOrigin="0.925,0.635"/>
            <MenuItem Header="Import Data" Width="100"  BorderBrush="Gray" Background="AliceBlue" Command="{Binding SelectViewModelCommand}" 
         CommandParameter="{Binding ImportViewModel}"/>
            <MenuItem Header="Export Data" Width="100"  BorderBrush="Gray" Background="AliceBlue" Command="{Binding SelectViewModelCommand}" 
          CommandParameter="{Binding ExportViewModel}"/>
           

        </Menu>
        <ContentControl Grid.Row="1" Content="{Binding SelectedViewModel}"/>

    </Grid>
</Window>
