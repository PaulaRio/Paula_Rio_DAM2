<Window x:Class="Examen.View.PopUpCreateFileDirectoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:Examen"
         xmlns:view="clr-namespace:Examen.View"
         xmlns:viewModel="clr-namespace:Examen.ViewModel"
         mc:Ignorable="d" 
         d:DesignHeight="600" d:DesignWidth="600"
         Background="white"
        MaxHeight="600" MaxWidth="600"
        WindowStartupLocation="CenterScreen">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition  Height="*"/>
            <RowDefinition  Height="*"/>
            <RowDefinition  Height="*"/>
            <RowDefinition  Height="*"/>
            <RowDefinition  Height="*"/>
            <RowDefinition  Height="*"/>
            <RowDefinition  Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>

            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Background="DarkRed" Grid.ColumnSpan="2"  FontSize="20" Foreground="White" Content="Add New Planet" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Height="63" Margin="220,0,0,0">
            <Label Content="Planet Name" HorizontalContentAlignment="Center" FontSize="20" />
            <TextBox BorderBrush="Black" FontSize="30" Margin="30" Width="101" Text="{Binding Planet Name}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Height="63" Margin="220,0,0,0">
            <Label Content="Distance" HorizontalContentAlignment="Center" FontSize="20" />
            <TextBox BorderBrush="Black" FontSize="30" Margin="30" Width="101" Text="{Binding Planet Name}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Height="63" Margin="220,0,0,0">
            <Label Content="Planet Type" HorizontalContentAlignment="Center" FontSize="20" />
            <TextBox BorderBrush="Black" FontSize="30" Margin="30" Width="101" Text="{Binding Planet Name}"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Height="63" Margin="220,0,0,0">
            <Label Content="Atmosfere" HorizontalContentAlignment="Center" FontSize="20" />
            <TextBox BorderBrush="Black" FontSize="30" Margin="30" Width="101" Text="{Binding Planet Name}"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Height="63" Margin="220,0,0,0">
            <Label Content="Temperature" HorizontalContentAlignment="Center" FontSize="20" />
            <TextBox BorderBrush="Black" FontSize="30" Margin="30" Width="101" Text="{Binding Planet Name}"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Height="63" Margin="220,0,0,0">
            <Label Content="Image Name" HorizontalContentAlignment="Center" FontSize="20" />
            <TextBox BorderBrush="Black" FontSize="30" Margin="30" Width="101" Text="{Binding Planet Name}"/>
        </StackPanel>
        <Button Grid.Column="0" Grid.Row="7" Margin="30,26,0,32" Content="Cancel" Background="LightGray" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CancelCommand}" />
        <Button Grid.Column="2" Grid.Row="7" Margin="0,18,10,22" Content="Create" Background="Blue" FontSize="25" Foreground="White" HorizontalContentAlignment="Center" Height="60" Command="{Binding CreateCommand}" />

    </Grid>
</Window>
