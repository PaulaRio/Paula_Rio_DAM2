<Window x:Class="PlantillaWPF.View.AddObjetoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlantillaWPF.View"
      xmlns:viewModel="clr-namespace:PlantillaWPF.ViewModel" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance Type=viewModel:AddObjetoViewModel}"
      mc:Ignorable="d" 
      Height="600" Width="450"
      Title="AddObjetoView"
      Background="DarkSeaGreen">

    <Grid>
        <Border CornerRadius="10" Background="Ivory" Width="300" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <StackPanel Margin="0,-10,0,0">
               

                <!-- Título de la ventana -->
                <Label Content="Add" FontWeight="Bold" FontSize="24" Foreground="DarkSlateGray" Margin="0,0,0,20" HorizontalAlignment="Center" Height="45" Width="90" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <!-- Campo para el título -->
                <Label Content="Nombre" Foreground="LightSlateGray" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10">
                    <ui:TextBox Text="{Binding Nombre}" PlaceholderText="Enter the Title" Height="40" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>
                </Border>


                <!-- Campo para la fecha -->
                <!--<Label Content="Date" Foreground="LightSlateGray" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10">
                    <DatePicker Height="40" Margin="0,0,0,10"/>
                </Border>-->

                <!-- Campo para Lifetime Gross -->
                <Label Content="Descripcion" Foreground="LightSlateGray" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10">
                    <ui:TextBox Text="{Binding Descripcion}" PlaceholderText="Enter the Lifetime Gross" Height="40" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>
                </Border>

                <Label Content="Imagen" Foreground="LightSlateGray" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10">
                    <ui:TextBox Text="{Binding Photo}" PlaceholderText="Enter the Lifetime Gross" Height="40" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>
                </Border>
                
                <Label Content="IdAutor" Foreground="LightSlateGray" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10">
                    <ui:TextBox Text="{Binding IdAutor}" PlaceholderText="Enter the Lifetime Gross" Height="40" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>
                </Border>
                <Label Content="IdsGrupos" Foreground="LightSlateGray" Margin="0,0,0,5" FontWeight="Bold"/>
                <Border BorderThickness="0,0,0,2" BorderBrush="LightGray" Margin="0,0,0,10">
                    <ui:TextBox Text="{Binding IdsGrupos}" PlaceholderText="Enter the Lifetime Gross" Height="40" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>
                </Border>


                <Button Content="Back"  FontSize="15" Foreground="Ivory" Background="DarkSlateGray" BorderThickness="0" Cursor="Hand" Command="{Binding CancelarVentanaCommand}" Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,0,-34" Width="70"/>
                    <Button Content="Save"  FontSize="15" Foreground="Ivory" Background="DarkSlateGray" BorderThickness="0" Cursor="Hand" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,0,0,-34" Width="70"/>
               

            </StackPanel>
        </Border>
    </Grid>
</Window>
