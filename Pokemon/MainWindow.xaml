<Window x:Class="Pokemon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pokemon"
        xmlns:view="clr-namespace:Pokemon.View"
        xmlns:viewModel="clr-namespace:Pokemon.ViewModel" 
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModel:BattleViewModel}">
            <view:BattleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:TeamHistoricoViewModel}">
            <view:TeamHistoricoView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Menu FontSize="15" Grid.Row="0">
            <MenuItem Header="Battle"/>
            <MenuItem Header="Team"/>
            <MenuItem Header="Historico"/>
        </Menu>
        <ContentControl Grid.Row="1" Content="{Binding SelectedViewModel}"/>
        <view:BattleView/>
        <view:BattleView/>
        <view:BattleView/>
    </Grid>
</Window>
