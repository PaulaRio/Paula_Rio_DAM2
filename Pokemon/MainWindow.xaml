<Window x:Class="Pokemon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pokemon"
        xmlns:view="clr-namespace:Pokemon.View"
        xmlns:viewModel="clr-namespace:Pokemon.ViewModel" 
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="LightPink">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModel:BattleViewModel}">
            <view:BattleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:TeamViewModel}">
            <view:TeamView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:HistoricoViewModel}">
            <view:HistoricoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ImportViewModel}">
            <view:ImportView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>
        
        <Menu FontSize="15" Grid.Row="0" HorizontalAlignment="Stretch" Margin="20" Width="300"  Height="30" >
            
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="4"  />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <MenuItem Header="Battle" Width="auto" BorderBrush="Gray" Background="AliceBlue" />
            <MenuItem Header="Team" Width="auto" BorderBrush="Gray" Background="AliceBlue"/>
            <MenuItem Header="Historico" Width="auto" BorderBrush="Gray" Background="AliceBlue"/>
            <MenuItem Header="Import" Width="auto" BorderBrush="Gray" Background="AliceBlue"/>
        </Menu>
        <ContentControl Grid.Row="1" Content="{Binding SelectedViewModel}"/>
      
    </Grid>
</Window>
