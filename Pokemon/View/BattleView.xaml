<UserControl x:Class="Pokemon.View.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pokemon.View"
             xmlns:viewModel="clr-namespace:Pokemon.ViewModel" 
             d:DataContext="{d:DesignInstance Type=viewModel:BattleViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="LightPink">



    <Grid >

        <Grid VerticalAlignment="Top" Margin="0,10,0,0" Height="310">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TextBlock Izquierdo -->
            <TextBlock Grid.Column="0" Text="{Binding CurrentPokemonAttack}" FontSize="36" Foreground="{Binding ColorIsShiny}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="133,166,0,0" RenderTransformOrigin="0.473,1.753" Height="40" FontWeight="Bold"/>

            <!-- Imagen en el Centro -->
            <Image Grid.Column="1"  Source="{Binding CurrentPokemonPath}" Stretch="Uniform"  Width="200" Height="200" HorizontalAlignment="Left"  Margin="28,90,0,20"/>

            <!-- Barra de Progreso Derecha -->
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="266,159,0,0" Grid.ColumnSpan="2">
                <TextBlock HorizontalAlignment="Center" FontSize="16" Foreground="Blue" Text="{Binding ElementName=HpStat, Path=Value, StringFormat={}{0:0}%}" />
                <ProgressBar Value="{Binding ChangingPokeHP}"   Maximum="{Binding CurrentPokemonHP}" Width="220" Height="25" Name="HpStat" />
            </StackPanel>

        </Grid>

        <Border Height="120" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="10" BorderBrush="Gray" BorderThickness="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Gray" Offset="1" />
                    <GradientStop Color="LightGray" Offset="0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.CornerRadius>
                <CornerRadius TopLeft="20" TopRight="20" BottomLeft="0" BottomRight="0"/>
            </Border.CornerRadius>
        </Border>
        <!-- Parte Inferior -->
        <Grid VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Botones -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="Escapar" Background="Red" Foreground="White" Grid.Column="0"  
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Width="100" FontSize="22"
             Command="{Binding Escape_ClickCommand}"/>
            <Button Content="Atacar" Background="Blue" Foreground="White" Grid.Column="1" 
            Height="70"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Width="150" FontSize="22" />
            <Button Content="Capturar" Background="Magenta" Foreground="White" Grid.Column="2" 
            Height="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Width="100" FontSize="22" />


            <!--<ProgressBar  Grid.Row="1" Grid.ColumnSpan="3" Value="0" Maximum="100" Height="20" Margin="10" HorizontalAlignment="Stretch"  />-->
            <ProgressBar   Grid.Row="1" Grid.ColumnSpan="3" Height="20" Minimum="0" Maximum="100" Value="{Binding OurChangingHP}" Name="pbStatus" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElementName=pbStatus, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>


</UserControl>
