<UserControl x:Class="Pokemon.View.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pokemon.View"
             xmlns:viewModel="clr-namespace:Pokemon.ViewModel" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="LightPink">

    <Grid>

        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Parte Superior -->
            <StackPanel VerticalAlignment="Top" Grid.Row="0" Height="320">
                <ItemsControl ItemsSource="{Binding Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <StackPanel Orientation="Horizontal" Height="322" Width="378">
                        <TextBlock Text="120" FontSize="24" Foreground="Red" VerticalAlignment="Center" Margin="10" HorizontalAlignment="Left"/>
                        <Image  Width="100" Height="100" Margin="10"/>
                        <ProgressBar Value="45" Maximum="100" Width="107" Height="20" HorizontalAlignment="Right" RenderTransformOrigin="1.464,0.559" />
                    </StackPanel>
                </ItemsControl>
            </StackPanel>

            <Border Height="120" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="10" BorderBrush="Gray" BorderThickness="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Gray" Offset="1" />
                        <GradientStop Color="LightGray" Offset="0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.CornerRadius>
                    <CornerRadius TopLeft="20" TopRight="20" BottomLeft="0" BottomRight="0"/>
                </Border.CornerRadius>
            </Border>
            <!-- Parte Inferior -->
            <Grid VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Botones -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="Escapar" Background="Red" Foreground="White" Grid.Column="0"  
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Width="100" FontSize="22"/>
                <Button Content="Atacar" Background="Blue" Foreground="White" Grid.Column="1" 
            Height="70"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Width="150" FontSize="22" />
                <Button Content="Capturar" Background="Magenta" Foreground="White" Grid.Column="2" 
            Height="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" Width="100" FontSize="22" />

                <!-- Barra de Captura -->
                <ProgressBar  Grid.Row="1" Grid.ColumnSpan="3" Value="0" Maximum="100" Height="20" Margin="10" HorizontalAlignment="Stretch"  />

            </Grid>
        </Grid>

    </Grid>
</UserControl>
